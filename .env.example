# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which LLM backend the wrapper in planner/llm.py uses.
#   subscription = Claude Agent SDK, the developer's Claude plan, local dev only
#   api          = anthropic SDK, needs ANTHROPIC_API_KEY, used for the deployed demo
LLM_BACKEND=subscription

# Required when LLM_BACKEND=api. On Streamlit Community Cloud this goes in
# Streamlit secrets instead, and the Claude Console should have a spend limit set.
ANTHROPIC_API_KEY=

# MODEL_FAST   — intake questions and validation retries
# MODEL_STRONG — path planning and the .docx prose
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5

# --- the Dify backend (optional) ------------------------------------------
# The workflow in dify/course-planner.yml runs the agent loop on Dify and
# calls service/tool_api.py for every fact. `planner/dify.py` drives it.
# None of this is needed for the local or deployed Streamlit app.

# The app key Dify shows under `API Access` after you import the workflow.
DIFY_API_KEY=
# Dify Cloud is https://api.dify.ai/v1 (the default). Self-hosted is usually
# http://localhost/v1.
DIFY_BASE_URL=

# The shared token between the workflow and the tool service. Both sides need
# the same value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_API_TOKEN=
# Where *Dify* reaches the tool service — not where we reach it. A self-hosted
# Dify in Docker sees the host as host.docker.internal; Dify Cloud needs a
# publicly reachable URL (a tunnel, or a real deploy).
TOOL_API_BASE=http://host.docker.internal:8601
