# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which LLM backend the wrapper in planner/llm.py uses.
#   subscription = Claude Agent SDK, the developer's Claude plan, local dev only
#   api          = anthropic SDK, needs ANTHROPIC_API_KEY, used for the deployed demo
LLM_BACKEND=subscription

# Required when LLM_BACKEND=api. On Streamlit Community Cloud this goes in
# Streamlit secrets instead, and the Claude Console should have a spend limit set.
ANTHROPIC_API_KEY=

# MODEL_FAST   — intake questions and validation retries
# MODEL_STRONG — path planning and the .docx prose
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5
