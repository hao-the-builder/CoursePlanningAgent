# Copy this into Streamlit Community Cloud's "Secrets" box for the app, or to
# .streamlit/secrets.toml for a local run. NEVER commit the real file —
# .gitignore excludes it, and hard rule 8 says a key lives in .env or in
# Streamlit secrets and nowhere else.
#
# Set a spend limit in the Claude Console before deploying.

LLM_BACKEND = "api"
ANTHROPIC_API_KEY = "sk-ant-..."
MODEL_FAST = "claude-haiku-5-5"
MODEL_STRONG = "claude-opus-5-5"
