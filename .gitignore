# --- secrets --------------------------------------------------------------
.env
.streamlit/secrets.toml

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- run logs (evidence, regenerated per run) -----------------------------
logs/*
!logs/.gitkeep

# --- generated student outputs -------------------------------------------
# The sample under samples/ is committed on purpose; real generated plans
# are not.
outputs/*.xlsx
outputs/*.docx
outputs/*.zip
outputs/_tmp/
/*.xlsx
/*.docx
!samples/*.xlsx

# data/VERIFY.pdf is committed — it is the pack the developer checks by hand.
# The HTML it is rendered from is scratch.
data/VERIFY.html

# --- os / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- raw binaries ---------------------------------------------------------
# The 68 requirement PDFs (~43MB) and the curriculum image are official
# sources, re-downloadable byte-for-byte with:
#     python pipeline/fetch_requirements.py
#     python pipeline/fetch_common_core.py
# Provenance survives without them: raw/SOURCES.md records the URL, size and
# SHA-256 of every file, and raw/_manifest.jsonl is committed. Keeping them out
# of git keeps the clone small for Streamlit Cloud deploys.
# To archive them instead, delete these two lines and re-add.
raw/**/*.pdf
raw/**/*.jpg

# a screenshot dropped in the project root is not part of the project
/*.png
/*.jpg
